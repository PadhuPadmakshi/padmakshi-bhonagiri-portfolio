<h2>Responsive and usability notes</h2>
<ul>
    <li><strong>Mobile-first:</strong> layouts reflow at 320px wide and at 200% zoom without horizontal scrolling; the NJDOL weekly certification rebuild is the production example.</li>
    <li><strong>Cross-browser:</strong> Centene regression passes covered Chrome, Edge, Firefox, and Safari, on desktop and mobile.</li>
    <li><strong>Design-system transition:</strong> Bootstrap and Material today, enterprise design system as it rolls out — tokens can theme Bootstrap/Material components during the transition, and new pages use token components directly, rather than a big-bang rewrite.</li>
    <li><strong>What is not claimed:</strong> no accessibility certification, no HCI degree, no Figma files from client work, and no outcome metrics the resume does not give. The evidence is the work and the code.</li>
</ul>
<script>
(function () {
    'use strict';
    var step = 1, names = { 1: 'Your details', 2: 'Contact and county', 3: 'Review and confirm' };
    function showStep() {
        [1, 2, 3].forEach(function (n) { document.getElementById('ux-step-' + n).hidden = (n !== step); });
        document.getElementById('ux-step-label').textContent = step + ' of 3';
        document.getElementById('ux-step-name').textContent = names[step];
        document.getElementById('ux-back').disabled = (step === 1);
        document.getElementById('ux-next').textContent = (step === 3) ? 'Submit sample' : 'Next step';
    }
    function errorsFor() {
        var errs = [];
        if (step === 1) {
            if (!document.getElementById('UxFirstName').value.trim()) errs.push(['UxFirstName', 'Enter your first name.']);
            if (!document.getElementById('UxLastName').value.trim()) errs.push(['UxLastName', 'Enter your last name.']);
        }
        if (step === 2) {
            var e = document.getElementById('UxEmail');
            if (!e.value.trim()) errs.push(['UxEmail', 'Enter your email address.']);
            else if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(e.value.trim())) errs.push(['UxEmail', 'Enter an email address in the correct format, like name@example.com.']);
            if (!document.getElementById('UxCounty').value.trim()) errs.push(['UxCounty', 'Enter a county.']);
        }
        if (step === 3 && !document.getElementById('UxTerms').checked) errs.push(['UxTerms', 'Confirm you understand this is a fictional sample application.']);
        return errs;
    }
    document.getElementById('ux-next').addEventListener('click', function () {
        var errs = errorsFor(), summary = document.getElementById('ux-error-summary'), list = document.getElementById('ux-error-list');
        if (errs.length) {
            list.innerHTML = '';
            errs.forEach(function (er) { var li = document.createElement('li'); var a = document.createElement('a'); a.href = '#' + er[0]; a.textContent = er[1]; li.appendChild(a); list.appendChild(li); });
            summary.hidden = false; document.getElementById('ux-form-status').textContent = 'Please fix the errors before continuing.';
            return;
        }
        summary.hidden = true;
        if (step < 3) { step++; showStep(); }
        else { var c = document.getElementById('ux-confirmation'); document.getElementById('ux-confirmation-text').textContent = 'Sample multi-step form complete. In the full app, this would create a reference number and a confirmation page.'; c.hidden = false; document.getElementById('ux-form-status').textContent = 'Sample multi-step form complete.'; }
    });
    document.getElementById('ux-back').addEventListener('click', function () { if (step > 1) { step--; showStep(); } });
    document.getElementById('ux-save').addEventListener('click', function () { document.getElementById('ux-form-status').textContent = 'Draft saved on this page only (fictional demo). In the Frontiers pattern, save-and-resume keeps the in-progress submission so it can be finished later.'; });
    showStep();
})();
</script>
